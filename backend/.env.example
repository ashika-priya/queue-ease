# Queue Ease Backend — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.

PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/queue_ease?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_key_at_least_32_chars
CLIENT_URL=https://your-app.vercel.app
NODE_ENV=production